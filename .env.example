# Copy this file to .env and fill in your own Supabase project values.
# .env is gitignored — never commit real credentials.
# See CLAUDE.md "Guardrails > Secrets" before adding anything here.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional, dev-only: set to 1 to skip the Apple/Google sign-in gate on
# `expo start --web`, where neither provider has a real web implementation.
# Has no effect in a production build (also requires __DEV__ to be true).
EXPO_PUBLIC_SKIP_AUTH=
