# Copy this file to .env and fill in your own Supabase project values.
# .env is gitignored — never commit real credentials.
# See CLAUDE.md "Guardrails > Secrets" before adding anything here.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Clerk is the identity provider (see docs/clerk-migration-plan.md). None of
# these are secrets — all are public client identifiers; Supabase validates
# Clerk's session tokens directly via Third-Party Auth (JWKS), configured in
# the Supabase dashboard + supabase/config.toml, not via any key here.
#
# From the Clerk Dashboard (API Keys):
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
# From Google Cloud Console (same OAuth client already used for Supabase's
# Google provider can be reused here — see appleSignIn.ts/googleSignIn.ts's
# legacy client IDs for the existing values). Only needed for native Google
# sign-in via @clerk/expo-google-signin (see src/features/auth/useSocialSignIn.ts):
EXPO_PUBLIC_CLERK_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_CLERK_GOOGLE_IOS_CLIENT_ID=
# Reversed iOS client ID, e.g. com.googleusercontent.apps.<ios-client-id-prefix>
# — read by @clerk/expo-google-signin's config plugin at `expo prebuild`/EAS
# Build time (see node_modules/@clerk/expo-google-signin/app.plugin.js), not
# at runtime, so this must be set before a native build, not just in-app.
EXPO_PUBLIC_CLERK_GOOGLE_IOS_URL_SCHEME=

# Optional, dev-only: set to 1 to skip the Apple/Google sign-in gate on
# `expo start --web`, where neither provider has a real web implementation.
# Has no effect in a production build (also requires __DEV__ to be true).
EXPO_PUBLIC_SKIP_AUTH=
